# OpenAI
OPENAI_API_KEY=
# gpt-4.1-mini, not a reasoning model — cheaper and avoids reasoning-token
# budget failures on the structured-output agent calls (see agents/planning.ts).
AI_MODEL=gpt-4.1-mini
# Keep false while developing templates/UI. Set to true only for live API tests.
ENABLE_LIVE_AI=false

# Gemini (Nano Banana / gemini-2.5-flash-image) — section image generation
GEMINI_API_KEY=

# Supabase public browser config
# Do not use the service role key in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
